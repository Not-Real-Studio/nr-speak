{
  "name": "@notrealstudio/speak",
  "version": "0.1.0",
  "description": "Текст → речь: движки за одним интерфейсом (Gemini TTS в Vertex и AI Studio, Google Chirp 3 HD, Microsoft Edge read-aloud, любой OpenAI-совместимый /v1/audio/speech), каталог голосов с резолвом коротких имён, нормализатор L0 (markdown/html → текст для слуха), сегменты, кэш сегментов, перекодирование через ffmpeg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "defuddle": "^0.19.4",
    "linkedom": "^0.18.13",
    "msedge-tts": "^2.0.9",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
